{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["node", "bun"],
    "paths": { "@/*": ["./vendor/openscreen/src/*"] }
  },
  "include": ["src", "examples", "scripts"]
}
